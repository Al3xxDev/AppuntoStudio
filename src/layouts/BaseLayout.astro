---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
}

const {
  title = `${SITE.name} — Architettura e Interni Roma`,
  description = SITE.description,
  image = '/images/appartamento-mg-soggiorno.webp',
  canonical = Astro.url.href,
  type = 'website'
} = Astro.props;

const siteUrl = SITE.url;
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

// Schema.org Structured Data (ArchitecturalFirm)
const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'ArchitecturalFirm',
  'name': SITE.name,
  'description': SITE.description,
  'url': siteUrl,
  'telephone': '+393498328323',
  'image': fullImageUrl,
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': SITE.address.street,
    'addressLocality': SITE.address.city,
    'postalCode': SITE.address.postalCode,
    'addressRegion': SITE.address.province,
    'addressCountry': 'IT'
  },
  'areaServed': {
    '@type': 'City',
    'name': 'Roma'
  },
  'sameAs': [
    SITE.socials.houzz,
    SITE.socials.facebook
  ]
};
---

<!doctype html>
<html lang="it" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            root.classList.remove('js-motion', 'motion-sequence-pending');
            return;
          }
          root.classList.add('js-motion');
          if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
            root.classList.add('motion-sequence-pending');
          }
          window.__appuntoFallbackTimer = window.setTimeout(function () {
            root.classList.remove('js-motion', 'motion-sequence-pending');
            root.classList.add('motion-sequence-fallback');
          }, 2500);
        } catch (e) {
          document.documentElement.classList.remove('js-motion', 'motion-sequence-pending');
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#F8F7F4" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageUrl} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  </head>
  <body class="min-h-full flex flex-col bg-[#F8F7F4] text-[#292925] font-sans selection:bg-[#D7CDBE] selection:text-[#292925]">
    <!-- Accessibility Skip to Main Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#292925] focus:text-[#F8F7F4] focus:font-mono focus:text-xs focus:ring-2 focus:ring-[#8A8D76]"
    >
      Salta direttamente al contenuto principale
    </a>

    <!-- Global Header -->
    <Header currentPath={Astro.url.pathname} />

    <!-- Main Content Area -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <script>
      import { initEditorialMotion } from '../scripts/editorial-motion';
      void initEditorialMotion();
      document.addEventListener('astro:after-swap', () => {
        void initEditorialMotion();
      });
    </script>
  </body>
</html>
