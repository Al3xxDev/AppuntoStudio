---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  priority?: boolean;
  variant?: 'standard' | 'featured' | 'tall' | 'wide' | 'diptych';
  aspectRatio?: 'standard' | 'wide' | 'tall' | 'portrait' | 'panoramic';
}

const {
  project,
  priority = false,
  variant = 'standard',
  aspectRatio = variant === 'tall' ? 'tall' : variant === 'featured' ? 'wide' : 'wide',
} = Astro.props;

// Aspect ratios calibrated for architectural photography
const aspectClass = {
  standard: 'aspect-[4/3]',
  wide: 'aspect-[16/10]',
  tall: 'aspect-[4/5] sm:aspect-[3/4]',
  portrait: 'aspect-[3/4]',
  panoramic: 'aspect-[16/9] sm:aspect-[2.2/1]',
}[aspectRatio];
---

<article class="group flex flex-col justify-between transition-colors duration-300">
  <!-- Photography Container with Soft Rounded Corners, Subtle Sand Border & Gentle Shadow -->
  <a
    href={`/progetti/${project.slug}`}
    class="block relative w-full overflow-hidden rounded-[14px] sm:rounded-[16px] bg-[#EAE6DF] border border-[#E2DBD0]/90 shadow-[0_4px_20px_-4px_rgba(41,41,37,0.05)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925]"
    aria-label={`Esplora il progetto ${project.title} — ${project.subtitle}`}
  >
    <div class:list={['relative w-full overflow-hidden', aspectClass]}>
      <picture>
        <source srcset={project.coverImage.webp} type="image/webp" />
        <img
          src={project.coverImage.src}
          alt={project.coverImage.alt}
          width={project.coverImage.width}
          height={project.coverImage.height}
          loading={priority ? 'eager' : 'lazy'}
          decoding={priority ? 'sync' : 'async'}
          fetchpriority={priority ? 'high' : 'auto'}
          class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.025]"
        />
      </picture>
      <!-- Extremely subtle warm hover tint -->
      <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/3 transition-colors duration-500" aria-hidden="true" />
    </div>
  </a>

  <!-- Project Information Under Photography: Natural, Breathing, Editorial -->
  <div class="mt-4 sm:mt-5 flex flex-col space-y-1.5">
    <div class="flex items-center justify-between gap-3 text-xs font-mono text-[#8A8D76]">
      <span class="uppercase tracking-widest text-[11px]">{project.category}</span>
      <span class="text-[#77756E] text-[11px]">{project.location}</span>
    </div>

    <h3 class="text-2xl sm:text-[26px] font-light tracking-tight text-[#292925] group-hover:text-[#8A8D76] transition-colors duration-200">
      <a href={`/progetti/${project.slug}`} class="focus-visible:outline-none focus-visible:underline">
        {project.title}
      </a>
    </h3>

    <p class="text-sm sm:text-base text-[#77756E] font-light leading-relaxed">
      {project.subtitle}
    </p>

    <div class="pt-2">
      <a
        href={`/progetti/${project.slug}`}
        class="inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.16em] font-medium text-[#292925] group-hover:text-[#8A8D76] group-hover:translate-x-1 transition-all"
      >
        <span>Vedi progetto</span>
        <svg class="w-3.5 h-3.5 text-[#8A8D76]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</article>
