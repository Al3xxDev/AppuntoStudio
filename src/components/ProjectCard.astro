---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  priority?: boolean;
  variant?: 'standard' | 'featured' | 'tall' | 'wide' | 'diptych';
  aspectRatio?: 'standard' | 'wide' | 'tall' | 'portrait' | 'panoramic';
}

const {
  project,
  priority = false,
  variant = 'standard',
  aspectRatio = variant === 'tall' ? 'tall' : variant === 'featured' ? 'wide' : 'wide',
} = Astro.props;

// Aspect ratios
const aspectClass = {
  standard: 'aspect-[4/3]',
  wide: 'aspect-[16/10]',
  tall: 'aspect-[4/5] sm:aspect-[3/4]',
  portrait: 'aspect-[3/4]',
  panoramic: 'aspect-[21/9] sm:aspect-[2.3/1]',
}[aspectRatio];
---

<article class="group relative flex flex-col justify-between transition-colors duration-300">
  <!-- Architectural Passe-Partout Mounting Plate -->
  <div class="relative bg-[#F4F1EA] border border-[#D7CDBE] p-3 sm:p-5 rounded-[1px] group-hover:border-[#8A8D76] transition-all duration-300 shadow-[0_1px_3px_rgba(41,41,37,0.03)]">
    <!-- Corner Architectural Registration Marks (+) -->
    <div class="pointer-events-none select-none" aria-hidden="true">
      <span class="absolute top-1.5 left-2 font-mono text-[9px] text-[#8A8D76]/60 group-hover:text-[#8A8D76] transition-colors leading-none">+</span>
      <span class="absolute top-1.5 right-2 font-mono text-[9px] text-[#8A8D76]/60 group-hover:text-[#8A8D76] transition-colors leading-none">+</span>
      <span class="absolute bottom-1.5 left-2 font-mono text-[9px] text-[#8A8D76]/60 group-hover:text-[#8A8D76] transition-colors leading-none">+</span>
      <span class="absolute bottom-1.5 right-2 font-mono text-[9px] text-[#8A8D76]/60 group-hover:text-[#8A8D76] transition-colors leading-none">+</span>
    </div>

    <!-- Floating Technical Plate Label -->
    <div class="absolute -top-3 left-4 z-10 px-2.5 py-0.5 bg-[#292925] text-[#F8F7F4] font-mono text-[9px] uppercase tracking-widest border border-[#292925] shadow-xs select-none">
      TAV. {project.index} / {project.category.toUpperCase()}
    </div>

    <!-- Inner Picture Container with hairline framing and micro-rounding -->
    <a
      href={`/progetti/${project.slug}`}
      class="block relative overflow-hidden bg-[#EAE6DF] border border-[#292925]/10 rounded-[2px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925]"
      aria-label={`Esplora il progetto ${project.title} — ${project.subtitle}`}
    >
      <div class:list={['relative w-full overflow-hidden', aspectClass]}>
        <picture>
          <source srcset={project.coverImage.webp} type="image/webp" />
          <img
            src={project.coverImage.src}
            alt={project.coverImage.alt}
            width={project.coverImage.width}
            height={project.coverImage.height}
            loading={priority ? 'eager' : 'lazy'}
            decoding={priority ? 'sync' : 'async'}
            fetchpriority={priority ? 'high' : 'auto'}
            class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.028]"
          />
        </picture>
        <!-- Subtle architectural hover tint -->
        <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/5 transition-colors duration-300" aria-hidden="true" />
      </div>
    </a>

    <!-- Integrated Plate Micro-Plaque -->
    <div class="mt-3 pt-2.5 border-t border-[#D7CDBE]/70 flex items-center justify-between text-xs font-mono">
      <span class="text-[#77756E] text-[11px] truncate">
        {project.location}
      </span>
      <span class="text-[#8A8D76] text-[10px] uppercase tracking-wider shrink-0 ml-2">
        {project.gallery.length} foto
      </span>
    </div>
  </div>

  <!-- Editorial Narrative & Metainfo Under Plate -->
  <div class="mt-4 flex flex-col flex-grow justify-between space-y-3">
    <div>
      <div class="flex items-center gap-2 font-mono text-xs text-[#77756E] mb-1">
        <span class="text-[#8A8D76]">[{project.index}]</span>
        <span class="uppercase tracking-widest text-[11px]">{project.category}</span>
        {project.year && (
          <>
            <span class="text-[#D7CDBE]">•</span>
            <span>{project.year}</span>
          </>
        )}
      </div>

      <h3 class="text-2xl sm:text-3xl font-light tracking-tight text-[#292925] group-hover:text-[#8A8D76] transition-colors duration-200">
        <a href={`/progetti/${project.slug}`} class="focus-visible:outline-none focus-visible:underline">
          {project.title}
        </a>
      </h3>

      <p class="mt-1.5 text-sm text-[#77756E] line-clamp-2 font-light leading-relaxed">
        {project.subtitle}
      </p>
    </div>

    <!-- Architectural action trigger -->
    <div class="pt-3 border-t border-[#E2DBD0]/60 flex items-center justify-between">
      <a
        href={`/progetti/${project.slug}`}
        class="inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.16em] font-medium text-[#292925] group-hover:translate-x-1 transition-transform"
      >
        <span>Vedi scheda intervento</span>
        <svg class="w-3.5 h-3.5 text-[#8A8D76]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
      <span class="font-mono text-[10px] text-[#77756E]">
        ROMA
      </span>
    </div>
  </div>
</article>
