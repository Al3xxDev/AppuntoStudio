---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
---

<article class="group relative flex flex-col justify-between border-t border-[#E2DBD0] pt-6 pb-8 transition-colors duration-300">
  <!-- Top meta header -->
  <div class="flex items-baseline justify-between gap-4 font-mono text-xs text-[#77756E] mb-4">
    <div class="flex items-center gap-2">
      <span class="text-[#8A8D76]">[{project.index}]</span>
      <span class="uppercase tracking-widest">{project.category}</span>
    </div>
    <span>{project.location}</span>
  </div>

  <!-- Image container -->
  <a
    href={`/progetti/${project.slug}`}
    class="block relative overflow-hidden bg-[#F1EFE9] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925] mb-5 aspect-[16/10] sm:aspect-[3/2]"
    aria-label={`Esplora il progetto ${project.title} — ${project.subtitle}`}
  >
    <picture>
      <source srcset={project.coverImage.webp} type="image/webp" />
      <img
        src={project.coverImage.src}
        alt={project.coverImage.alt}
        width={project.coverImage.width}
        height={project.coverImage.height}
        loading="eager"
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
        class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.03]"
      />
    </picture>
    <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/5 transition-colors duration-300" aria-hidden="true"></div>
  </a>

  <!-- Content & Title -->
  <div class="flex flex-col flex-grow justify-between">
    <div>
      <h3 class="text-2xl sm:text-3xl font-light tracking-tight text-[#292925] group-hover:text-[#8A8D76] transition-colors duration-200">
        <a href={`/progetti/${project.slug}`} class="focus-visible:outline-none focus-visible:underline">
          {project.title}
        </a>
      </h3>
      <p class="mt-2 text-sm text-[#77756E] line-clamp-2 font-light leading-relaxed">
        {project.subtitle}
      </p>
    </div>

    <div class="pt-4 mt-2 flex items-center justify-between border-t border-[#E2DBD0]/60">
      <span class="text-xs uppercase tracking-[0.16em] font-medium text-[#292925] group-hover:translate-x-1 transition-transform inline-flex items-center gap-1.5">
        Scheda del progetto
        <svg class="w-3.5 h-3.5 text-[#8A8D76]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </span>
      <span class="font-mono text-xs text-[#8A8D76]">
        {project.gallery.length} foto
      </span>
    </div>
  </div>
</article>
