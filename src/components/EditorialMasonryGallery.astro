---
import type { ProjectImage } from '../data/projects';

interface Props {
  photos: ProjectImage[];
  projectTitle: string;
}

const { photos, projectTitle } = Astro.props;

interface MasonryItem {
  img: ProjectImage;
  originalIndex: number;
  isPortrait: boolean;
  aspectMobile: number;
  aspectTablet: number;
  aspectDesktop: number;
}

function isPortraitPhoto(img: ProjectImage): boolean {
  const ratio = img.width / img.height;
  return img.orientation === 'portrait' || ratio < 0.92;
}

function clamp(val: number, min: number, max: number): number {
  return Math.max(min, Math.min(max, val));
}

function round3(val: number): number {
  return Math.round(val * 1000) / 1000;
}

/**
 * Deterministic Editorial Masonry Layout Planner
 * Distributes project photographs across two asymmetric masonry tracks on Desktop
 * (and two balanced tracks on Tablet, single chronological flow on Mobile),
 * preserving natural orientations while mathematically equalizing total track heights
 * so there are zero accidental white gaps inside or at the bottom of the gallery.
 */
function buildEditorialMasonry(items: ProjectImage[]) {
  const total = items.length;
  const annotated = items.map((img, idx) => ({
    img,
    originalIndex: idx,
    isPortrait: isPortraitPhoto(img),
    naturalRatio: img.width / img.height,
  }));

  const portraitCount = annotated.filter((a) => a.isPortrait).length;

  let leftFr = 6.5;
  let rightFr = 5.5;
  const leftRaw: typeof annotated = [];
  const rightRaw: typeof annotated = [];

  if (portraitCount > total / 2) {
    // Case A: Majority Portrait Gallery (e.g., Casa JD: 3 portraits + 1 landscape)
    // Narrower left track (5.2fr) for two vertical portraits; wider right track (6.8fr)
    // for the wide landscape at top + vertical portrait below.
    leftFr = 5.2;
    rightFr = 6.8;
    const portraits = annotated.filter((a) => a.isPortrait);
    const landscapes = annotated.filter((a) => !a.isPortrait);

    if (portraits.length >= 3 && landscapes.length >= 1) {
      leftRaw.push(portraits[0], portraits[1]);
      rightRaw.push(landscapes[0], ...portraits.slice(2), ...landscapes.slice(1));
    } else {
      annotated.forEach((item, i) => {
        if (i % 2 === 0) leftRaw.push(item);
        else rightRaw.push(item);
      });
    }
  } else if (portraitCount >= 1) {
    // Case B: Mixed Landscape + Portrait Gallery (e.g., Casa MG [6], Villa Residenziale [8])
    // Wider left track (6.8fr) for spacious landscapes; narrower right track (5.2fr)
    // so vertical portrait photos maintain a sleek 3:4 / 4:5 vertical frame without becoming gigantic.
    leftFr = 6.8;
    rightFr = 5.2;
    const targetLeftCount = Math.floor(total / 2);

    const portraits = annotated.filter((a) => a.isPortrait);
    const landscapes = annotated.filter((a) => !a.isPortrait);

    for (const item of landscapes) {
      if (leftRaw.length < targetLeftCount) {
        leftRaw.push(item);
      } else {
        rightRaw.push(item);
      }
    }
    // Insert portraits into rightRaw at a balanced middle position
    for (const p of portraits) {
      const insertIdx = Math.max(1, Math.min(rightRaw.length, Math.floor(rightRaw.length / 2)));
      rightRaw.splice(insertIdx, 0, p);
    }
  } else if (total % 2 === 1) {
    // Case C: Odd-Count All-Landscape Gallery (e.g., Casa Gracchi [7])
    // Left track (6.9fr) holds floor(N/2) = 3 large feature landscapes;
    // Right track (5.1fr) holds ceil(N/2) = 4 intermediate landscapes.
    // Because 6.9 / 5.1 ≈ 4 / 3, both tracks keep their natural ~3:2 / 4:3 proportions!
    leftFr = 6.9;
    rightFr = 5.1;
    const targetLeftCount = Math.floor(total / 2);
    annotated.forEach((item, i) => {
      if (i % 2 === 0 && leftRaw.length < targetLeftCount) {
        leftRaw.push(item);
      } else {
        rightRaw.push(item);
      }
    });
  } else {
    // Case D: Even-Count All-Landscape Gallery (e.g., Casa FP [6])
    leftFr = 6.5;
    rightFr = 5.5;
    annotated.forEach((item, i) => {
      if (i % 2 === 0) leftRaw.push(item);
      else rightRaw.push(item);
    });
  }

  // Assign initial base desktop & tablet aspect ratios with intentional masonry stagger
  const leftDesktopAspects = leftRaw.map((item, idx) => {
    if (item.isPortrait) {
      return idx % 2 === 0 ? 0.84 : 0.88;
    }
    if (total % 2 === 1 && portraitCount === 0) {
      // 3 wide feature photos against 4 intermediate photos
      return idx % 2 === 1 ? 1.30 : 1.36;
    }
    if (portraitCount === 0) {
      const pattern = [1.38, 1.56, 1.44, 1.36];
      return pattern[idx % pattern.length];
    }
    const base = clamp(item.naturalRatio, 1.33, 1.52);
    const offsets = [-0.02, -0.08, 0.0, -0.04];
    return clamp(base + offsets[idx % offsets.length], 1.32, 1.52);
  });

  const rightDesktopAspects = rightRaw.map((item, idx) => {
    if (item.isPortrait) {
      return portraitCount > total / 2 ? 0.90 : 0.78;
    }
    if (portraitCount > total / 2) {
      return 1.50;
    }
    if (total % 2 === 1 && portraitCount === 0) {
      const pattern = [1.38, 1.34, 1.38, 1.36];
      return pattern[idx % pattern.length];
    }
    const pattern = [1.34, 1.18, 1.24, 1.30];
    return pattern[idx % pattern.length];
  });

  // Reference geometry at Desktop (1216px container, 24px column gap -> 1192px net track width)
  const netDesktopWidth = 1192;
  const leftWidthDesktop = netDesktopWidth * (leftFr / 12);
  const rightWidthDesktop = netDesktopWidth * (rightFr / 12);
  const cardOverheadDesktop = 54; // 30px caption + 24px vertical gap

  const leftImgHeightDesktop = leftDesktopAspects.reduce(
    (sum, a) => sum + leftWidthDesktop / a,
    0
  );
  const leftTotalDesktop =
    leftImgHeightDesktop + leftRaw.length * 30 + Math.max(0, leftRaw.length - 1) * 24;

  const targetRightImgHeightDesktop =
    leftTotalDesktop - (rightRaw.length * 30 + Math.max(0, rightRaw.length - 1) * 24);

  // Scale non-portrait items in rightTrack (or all items if needed) so rightTotalDesktop === leftTotalDesktop
  const fixedRightHeightDesktop = rightDesktopAspects.reduce(
    (sum, a, idx) => (rightRaw[idx].isPortrait && portraitCount <= total / 2 ? sum + rightWidthDesktop / a : sum),
    0
  );
  const flexRightHeightDesktop = rightDesktopAspects.reduce(
    (sum, a, idx) => (rightRaw[idx].isPortrait && portraitCount <= total / 2 ? sum : sum + rightWidthDesktop / a),
    0
  );

  const desiredFlexHeightDesktop = Math.max(220, targetRightImgHeightDesktop - fixedRightHeightDesktop);
  const scaleFactorDesktop = flexRightHeightDesktop > 0 ? desiredFlexHeightDesktop / flexRightHeightDesktop : 1;

  const balancedRightDesktopAspects = rightDesktopAspects.map((a, idx) => {
    if (rightRaw[idx].isPortrait && portraitCount <= total / 2) {
      return round3(a);
    }
    // New height h' = h * scaleFactorDesktop => new aspect a' = a / scaleFactorDesktop
    return round3(clamp(a / scaleFactorDesktop, 0.76, 1.68));
  });

  // Tablet Equal-Width (1fr / 1fr at 768px -> 350px per track, 28px caption + 20px gap)
  const trackWidthTablet = 350;
  const leftTabletAspects = leftRaw.map((item, idx) => {
    if (item.isPortrait) return idx % 2 === 0 ? 0.84 : 0.88;
    if (total % 2 === 1 && portraitCount === 0) {
      return idx % 2 === 1 ? 1.08 : 1.04;
    }
    const pattern = [1.34, 1.46, 1.38, 1.32];
    return pattern[idx % pattern.length];
  });

  const rightTabletBase = rightRaw.map((item, idx) => {
    if (item.isPortrait) return 0.82;
    const pattern = [1.44, 1.30, 1.38, 1.42];
    return pattern[idx % pattern.length];
  });

  const leftImgHeightTablet = leftTabletAspects.reduce((sum, a) => sum + trackWidthTablet / a, 0);
  const leftTotalTablet =
    leftImgHeightTablet + leftRaw.length * 28 + Math.max(0, leftRaw.length - 1) * 20;
  const targetRightImgHeightTablet =
    leftTotalTablet - (rightRaw.length * 28 + Math.max(0, rightRaw.length - 1) * 20);
  const currentRightImgHeightTablet = rightTabletBase.reduce((sum, a) => sum + trackWidthTablet / a, 0);
  const tabletScale = currentRightImgHeightTablet > 0 ? targetRightImgHeightTablet / currentRightImgHeightTablet : 1;

  const balancedRightTabletAspects = rightTabletBase.map((a) =>
    round3(clamp(a / tabletScale, 0.72, 1.65))
  );

  const leftTrack: MasonryItem[] = leftRaw.map((item, idx) => ({
    img: item.img,
    originalIndex: item.originalIndex,
    isPortrait: item.isPortrait,
    aspectMobile: round3(item.isPortrait ? 0.82 : clamp(item.naturalRatio, 1.33, 1.55)),
    aspectTablet: round3(leftTabletAspects[idx]),
    aspectDesktop: round3(leftDesktopAspects[idx]),
  }));

  const rightTrack: MasonryItem[] = rightRaw.map((item, idx) => ({
    img: item.img,
    originalIndex: item.originalIndex,
    isPortrait: item.isPortrait,
    aspectMobile: round3(item.isPortrait ? 0.82 : clamp(item.naturalRatio, 1.33, 1.55)),
    aspectTablet: balancedRightTabletAspects[idx],
    aspectDesktop: balancedRightDesktopAspects[idx],
  }));

  return {
    leftFr,
    rightFr,
    leftTrack,
    rightTrack,
    cardOverheadDesktop,
  };
}

const { leftFr, rightFr, leftTrack, rightTrack } = buildEditorialMasonry(photos);
---

<div
  data-editorial-masonry
  style={`--left-fr: ${leftFr}fr; --right-fr: ${rightFr}fr;`}
  class="editorial-masonry-grid"
>
  <!-- Left Masonry Column Track -->
  <div class="masonry-track masonry-track-left">
    {leftTrack.map((item, idx) => {
      const isLastInTrack = idx === leftTrack.length - 1;
      return (
        <figure
          data-project-card
          data-photo-index={item.originalIndex}
          style={`--mobile-order: ${item.originalIndex}; --aspect-mobile: ${item.aspectMobile}; --aspect-tablet: ${item.aspectTablet}; --aspect-desktop: ${item.aspectDesktop};`}
          class:list={[
            'masonry-card group flex flex-col',
            isLastInTrack && 'masonry-card-last',
          ]}
        >
          <button
            type="button"
            data-lightbox-trigger
            data-lightbox-index={item.originalIndex}
            data-src={item.img.webp}
            data-alt={item.img.alt}
            data-caption={item.img.caption || item.img.alt}
            class:list={[
              'masonry-card-btn block w-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925] cursor-zoom-in',
              isLastInTrack && 'masonry-card-btn-last',
            ]}
            aria-label={`Ingrandisci fotografia ${item.originalIndex + 1} di ${photos.length} (${projectTitle}): ${item.img.alt}`}
          >
            <div class="masonry-photo-shell relative w-full overflow-hidden rounded-[12px] sm:rounded-[16px] bg-[#F3F1EC] border border-[#E2DBD0]/90 shadow-[0_3px_18px_-4px_rgba(41,41,37,0.05)] group-hover:shadow-[0_12px_30px_-6px_rgba(41,41,37,0.1)] group-hover:border-[#D5CEC2] transition-[border-color,box-shadow] duration-500">
              <div
                data-scroll-photo
                data-scroll-variant={item.isPortrait ? 'portrait' : 'landscape'}
                class="masonry-photo-frame relative w-full overflow-hidden rounded-[inherit]"
              >
                <picture>
                  <source srcset={item.img.webp} type="image/webp" />
                  <img
                    src={item.img.src}
                    alt={item.img.alt}
                    width={item.img.width}
                    height={item.img.height}
                    loading={item.originalIndex < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="scroll-photo-img w-full h-full object-cover object-center"
                  />
                </picture>
                <div
                  class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/3 transition-colors duration-500"
                  aria-hidden="true"
                />
              </div>
            </div>
          </button>

          <figcaption
            data-card-caption
            class="mt-2.5 flex items-center justify-between gap-3 text-xs text-[#77756E] font-light shrink-0 h-[20px]"
          >
            <p class="truncate text-[13px] leading-[20px]">
              {item.img.caption || item.img.alt}
            </p>
            <span class="inline-flex items-center gap-1 font-mono text-[10px] text-[#8A8D76] group-hover:text-[#292925] transition-colors shrink-0">
              <span>Zoom</span>
              <span
                class="inline-block transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                aria-hidden="true"
              >
                ↗
              </span>
            </span>
          </figcaption>
        </figure>
      );
    })}
  </div>

  <!-- Right Masonry Column Track -->
  <div class="masonry-track masonry-track-right">
    {rightTrack.map((item, idx) => {
      const isLastInTrack = idx === rightTrack.length - 1;
      return (
        <figure
          data-project-card
          data-photo-index={item.originalIndex}
          style={`--mobile-order: ${item.originalIndex}; --aspect-mobile: ${item.aspectMobile}; --aspect-tablet: ${item.aspectTablet}; --aspect-desktop: ${item.aspectDesktop};`}
          class:list={[
            'masonry-card group flex flex-col',
            isLastInTrack && 'masonry-card-last',
          ]}
        >
          <button
            type="button"
            data-lightbox-trigger
            data-lightbox-index={item.originalIndex}
            data-src={item.img.webp}
            data-alt={item.img.alt}
            data-caption={item.img.caption || item.img.alt}
            class:list={[
              'masonry-card-btn block w-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925] cursor-zoom-in',
              isLastInTrack && 'masonry-card-btn-last',
            ]}
            aria-label={`Ingrandisci fotografia ${item.originalIndex + 1} di ${photos.length} (${projectTitle}): ${item.img.alt}`}
          >
            <div class="masonry-photo-shell relative w-full overflow-hidden rounded-[12px] sm:rounded-[16px] bg-[#F3F1EC] border border-[#E2DBD0]/90 shadow-[0_3px_18px_-4px_rgba(41,41,37,0.05)] group-hover:shadow-[0_12px_30px_-6px_rgba(41,41,37,0.1)] group-hover:border-[#D5CEC2] transition-[border-color,box-shadow] duration-500">
              <div
                data-scroll-photo
                data-scroll-variant={item.isPortrait ? 'portrait' : 'landscape'}
                class="masonry-photo-frame relative w-full overflow-hidden rounded-[inherit]"
              >
                <picture>
                  <source srcset={item.img.webp} type="image/webp" />
                  <img
                    src={item.img.src}
                    alt={item.img.alt}
                    width={item.img.width}
                    height={item.img.height}
                    loading={item.originalIndex < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="scroll-photo-img w-full h-full object-cover object-center"
                  />
                </picture>
                <div
                  class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/3 transition-colors duration-500"
                  aria-hidden="true"
                />
              </div>
            </div>
          </button>

          <figcaption
            data-card-caption
            class="mt-2.5 flex items-center justify-between gap-3 text-xs text-[#77756E] font-light shrink-0 h-[20px]"
          >
            <p class="truncate text-[13px] leading-[20px]">
              {item.img.caption || item.img.alt}
            </p>
            <span class="inline-flex items-center gap-1 font-mono text-[10px] text-[#8A8D76] group-hover:text-[#292925] transition-colors shrink-0">
              <span>Zoom</span>
              <span
                class="inline-block transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                aria-hidden="true"
              >
                ↗
              </span>
            </span>
          </figcaption>
        </figure>
      );
    })}
  </div>
</div>

<script>
  function initEditorialMasonryGrids() {
    const grids = document.querySelectorAll<HTMLElement>('[data-editorial-masonry]');
    grids.forEach((grid) => {
      if (grid.dataset.masonryBound === 'true') return;
      grid.dataset.masonryBound = 'true';

      const leftTrack = grid.querySelector<HTMLElement>('.masonry-track-left');
      const rightTrack = grid.querySelector<HTMLElement>('.masonry-track-right');
      const lastRightFrame = rightTrack?.querySelector<HTMLElement>(
        '.masonry-card-last .masonry-photo-frame'
      );

      if (!leftTrack || !rightTrack || !lastRightFrame) return;

      let lastWidth = -1;

      const syncTracks = () => {
        const width = grid.clientWidth;
        if (width === lastWidth) return;
        lastWidth = width;

        lastRightFrame.style.height = '';
        if (window.innerWidth < 640) return;

        const leftH = leftTrack.getBoundingClientRect().height;
        const rightH = rightTrack.getBoundingClientRect().height;
        const delta = leftH - rightH;

        if (Math.abs(delta) >= 0.5 && Math.abs(delta) <= 140) {
          const frameH = lastRightFrame.getBoundingClientRect().height;
          const targetH = Math.max(180, frameH + delta);
          lastRightFrame.style.height = `${Math.round(targetH * 10) / 10}px`;
        }
      };

      syncTracks();

      const ro = new ResizeObserver(() => {
        syncTracks();
      });
      ro.observe(grid);
    });
  }

  initEditorialMasonryGrids();
  document.addEventListener('astro:page-load', initEditorialMasonryGrids);
</script>

