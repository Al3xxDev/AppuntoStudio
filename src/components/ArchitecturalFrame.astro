---
interface Props {
  src: string;
  webp?: string;
  alt: string;
  width?: number;
  height?: number;
  aspectRatio?: 'video' | 'wide' | 'panoramic' | 'standard' | 'portrait' | 'tall' | 'square' | 'cad' | 'auto';
  variant?: 'passepartout' | 'double-frame' | 'cad-sheet' | 'minimal';
  plateNumber?: string;
  caption?: string;
  metaText?: string;
  href?: string;
  priority?: boolean;
  showCrosshairs?: boolean;
  isPlan?: boolean;
  class?: string;
  lightbox?: boolean;
}

const {
  src,
  webp = src.replace(/\.(jpg|jpeg|png)$/i, '.webp'),
  alt,
  width = 1600,
  height = 1000,
  aspectRatio = 'standard',
  plateNumber,
  caption,
  metaText,
  href,
  priority = false,
  showCrosshairs = true,
  isPlan = false,
  class: className = '',
  lightbox = false,
} = Astro.props;

const variant = Astro.props.variant ?? (isPlan ? 'cad-sheet' : 'passepartout');

// Aspect ratio mapping
const aspectClasses = {
  video: 'aspect-[16/9]',
  wide: 'aspect-[16/10]',
  panoramic: 'aspect-[21/9] sm:aspect-[2.4/1]',
  standard: 'aspect-[4/3]',
  portrait: 'aspect-[3/4]',
  tall: 'aspect-[4/5] sm:aspect-[3/4]',
  square: 'aspect-square',
  cad: 'aspect-[16/10] sm:aspect-[2/1]',
  auto: '',
}[aspectRatio];

const isLink = !!href;
const isLightboxTrigger = lightbox && !href;
---

<div
  class:list={[
    'group relative flex flex-col justify-between transition-all duration-300',
    variant === 'passepartout' && 'bg-[#F4F1EA] border border-[#D7CDBE] p-2.5 sm:p-4 hover:border-[#8A8D76]',
    variant === 'double-frame' && 'bg-[#F4F1EA] border-2 border-[#D7CDBE] p-3 sm:p-5 ring-1 ring-[#D7CDBE]/60 hover:border-[#8A8D76]',
    variant === 'cad-sheet' && 'bg-white border-2 border-[#292925]/20 p-3 sm:p-5 shadow-xs hover:border-[#292925]/40',
    variant === 'minimal' && 'bg-transparent border-t border-[#D7CDBE] pt-4',
    className,
  ]}
>
  <!-- Architectural Corner Registration Crosshairs (+) -->
  {showCrosshairs && variant !== 'minimal' && (
    <div class="pointer-events-none select-none" aria-hidden="true">
      <span class="absolute top-1 left-1.5 font-mono text-[9px] text-[#8A8D76]/60 group-hover:text-[#8A8D76] transition-colors leading-none">+</span>
      <span class="absolute top-1 right-1.5 font-mono text-[9px] text-[#8A8D76]/60 group-hover:text-[#8A8D76] transition-colors leading-none">+</span>
      <span class="absolute bottom-1 left-1.5 font-mono text-[9px] text-[#8A8D76]/60 group-hover:text-[#8A8D76] transition-colors leading-none">+</span>
      <span class="absolute bottom-1 right-1.5 font-mono text-[9px] text-[#8A8D76]/60 group-hover:text-[#8A8D76] transition-colors leading-none">+</span>
    </div>
  )}

  <!-- Optional Floating Top Plate Number Tag -->
  {plateNumber && (
    <div class="absolute -top-3 left-4 z-10 px-2 py-0.5 bg-[#292925] text-[#F8F7F4] font-mono text-[9px] uppercase tracking-widest border border-[#292925] shadow-xs select-none">
      {plateNumber}
    </div>
  )}

  <!-- Inner Image Matting Frame -->
  <div class="relative w-full overflow-hidden">
    {isLink ? (
      <a
        href={href}
        class="block w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925]"
        aria-label={alt}
      >
        <div class:list={[
          'relative w-full overflow-hidden bg-[#EAE6DF] border border-[#292925]/10 rounded-[2px]',
          aspectClasses,
        ]}>
          <picture>
            <source srcset={webp} type="image/webp" />
            <img
              src={src}
              alt={alt}
              width={width}
              height={height}
              loading={priority ? 'eager' : 'lazy'}
              decoding={priority ? 'sync' : 'async'}
              fetchpriority={priority ? 'high' : 'auto'}
              class:list={[
                'w-full h-full object-center transition-transform duration-700 ease-out group-hover:scale-[1.025]',
                isPlan ? 'object-contain p-3 sm:p-6 bg-white' : 'object-cover',
              ]}
            />
          </picture>
          <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/4 transition-colors duration-300" aria-hidden="true" />
        </div>
      </a>
    ) : isLightboxTrigger ? (
      <button
        type="button"
        data-lightbox-trigger
        data-src={webp}
        data-alt={alt}
        data-caption={caption || alt}
        class="block w-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925] cursor-zoom-in"
        aria-label={`Ingrandisci fotografia: ${alt}`}
      >
        <div class:list={[
          'relative w-full overflow-hidden bg-[#EAE6DF] border border-[#292925]/10 rounded-[2px]',
          aspectClasses,
        ]}>
          <picture>
            <source srcset={webp} type="image/webp" />
            <img
              src={src}
              alt={alt}
              width={width}
              height={height}
              loading={priority ? 'eager' : 'lazy'}
              decoding={priority ? 'sync' : 'async'}
              fetchpriority={priority ? 'high' : 'auto'}
              class:list={[
                'w-full h-full object-center transition-transform duration-700 ease-out group-hover:scale-[1.025]',
                isPlan ? 'object-contain p-3 sm:p-6 bg-white' : 'object-cover',
              ]}
            />
          </picture>
          <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/4 transition-colors duration-300" aria-hidden="true" />
        </div>
      </button>
    ) : (
      <div class:list={[
        'relative w-full overflow-hidden bg-[#EAE6DF] border border-[#292925]/10 rounded-[2px]',
        aspectClasses,
      ]}>
        <picture>
          <source srcset={webp} type="image/webp" />
          <img
            src={src}
            alt={alt}
            width={width}
            height={height}
            loading={priority ? 'eager' : 'lazy'}
            decoding={priority ? 'sync' : 'async'}
            fetchpriority={priority ? 'high' : 'auto'}
            class:list={[
              'w-full h-full object-center transition-transform duration-700 ease-out group-hover:scale-[1.025]',
              isPlan ? 'object-contain p-3 sm:p-6 bg-white' : 'object-cover',
            ]}
          />
        </picture>
      </div>
    )}
  </div>

  <!-- Editorial Plaque / Caption Bar -->
  {(caption || metaText || isPlan) && (
    <div class="mt-3 pt-2.5 border-t border-[#D7CDBE]/70 flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 text-xs">
      <div class="flex items-center gap-2 overflow-hidden">
        {metaText && (
          <span class="font-mono text-[10px] text-[#8A8D76] uppercase tracking-wider shrink-0">
            [{metaText}]
          </span>
        )}
        {caption && (
          <span class="text-[#77756E] font-light truncate" title={caption}>
            {caption}
          </span>
        )}
        {isPlan && !caption && (
          <span class="font-mono text-[10px] text-[#292925] uppercase tracking-wider">
            Tavola Tecnica — Rilievo e Distribuzione Architettonica
          </span>
        )}
      </div>

      {isLightboxTrigger && (
        <span class="font-mono text-[10px] text-[#8A8D76] uppercase tracking-widest shrink-0 self-end sm:self-auto group-hover:text-[#292925] transition-colors inline-flex items-center gap-1">
          <span>+ Ingrandisci</span>
        </span>
      )}
      {isLink && (
        <span class="font-mono text-[10px] text-[#292925] uppercase tracking-wider shrink-0 self-end sm:self-auto inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          <span>Apri scheda</span>
          <span class="text-[#8A8D76]">→</span>
        </span>
      )}
    </div>
  )}
</div>
