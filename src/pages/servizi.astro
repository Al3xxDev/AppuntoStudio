---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERVICE_CATEGORIES } from '../data/services';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Servizi — Appuntostudio Architettura Roma"
  description="Dalla progettazione architettonica alla ristrutturazione edilizia di pregio, interior design e consulenze specialistiche a Roma."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24 sm:pt-20 sm:pb-36">
    <!-- Breadcrumb & Index Header -->
    <div class="flex items-center gap-2 font-mono text-xs text-[#77756E] pb-6 mb-8 border-b border-[#E2DBD0]">
      <a href="/" class="hover:text-[#292925] transition-colors">Home</a>
      <span>/</span>
      <span class="text-[#8A8D76]">[03 / SERVIZI]</span>
    </div>

    <!-- Editorial Header -->
    <header class="max-w-3xl mb-16 sm:mb-24">
      <h1 class="text-4xl sm:text-6xl font-light tracking-tight text-[#292925] leading-tight">
        Competenze integrate per ogni scala del progetto.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-[#77756E] font-light leading-relaxed">
        Lo studio offre un supporto tecnico e creativo continuativo, coprendo 18 ambiti operativi raggruppati in quattro macro-discipline. Dalla prima perizia alla consegna chiavi in mano.
      </p>
    </header>

    <!-- Detailed Service Categories -->
    <div class="space-y-16 sm:space-y-24 border-t border-[#E2DBD0] pt-16">
      {SERVICE_CATEGORIES.map((cat) => (
        <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start border-b border-[#E2DBD0] pb-16 last:border-b-0">
          <div class="lg:col-span-5 space-y-4">
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#8A8D76] block">
              [{cat.index} / DISCIPLINA]
            </span>
            <h2 class="text-3xl sm:text-4xl font-light tracking-tight text-[#292925]">
              {cat.title}
            </h2>
            <p class="text-base text-[#77756E] font-light leading-relaxed">
              {cat.description}
            </p>
          </div>

          <div class="lg:col-span-7 bg-[#F1EFE9]/50 border border-[#E2DBD0] p-6 sm:p-10">
            <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-[#8A8D76] mb-6">
              [ PRESTAZIONI COMPRESE ]
            </h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {cat.items.map(item => (
                <li class="flex items-start gap-3 text-sm text-[#292925] font-light py-2 border-b border-[#E2DBD0]/60">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#8A8D76] mt-2 shrink-0" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <!-- Contact Banner for Services -->
    <div class="mt-20 p-8 sm:p-12 bg-[#292925] text-[#F8F7F4] flex flex-col sm:flex-row items-center justify-between gap-8">
      <div class="max-w-xl">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#8A8D76] block mb-2">
          [ CONSULENZA PERSONALIZZATA ]
        </span>
        <h3 class="text-2xl sm:text-3xl font-light tracking-tight">
          Hai un immobile da valorizzare o ristrutturare?
        </h3>
        <p class="mt-2 text-sm text-[#A3A199] font-light">
          Contattaci direttamente al telefono per concordare una prima valutazione con il nostro team.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-4 shrink-0">
        <a
          href="/contatti"
          class="px-8 py-4 text-xs uppercase tracking-[0.18em] font-medium text-[#292925] bg-[#F8F7F4] hover:bg-[#D7CDBE] transition-colors"
        >
          <span>Richiedi un confronto</span>
        </a>
        <a
          href={SITE.phoneHref}
          class="px-6 py-4 text-xs font-mono text-[#F8F7F4] border border-[#77756E] hover:border-[#F8F7F4] transition-colors"
        >
          {SITE.phone}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
