---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { PROJECTS } from '../data/projects';
import { SERVICE_CATEGORIES } from '../data/services';
import { REVIEWS, REVIEWS_META } from '../data/reviews';

const featuredProjects = PROJECTS;
---

<BaseLayout
  title="Appuntostudio — Studio di Architettura e Interni a Roma"
  description="Studio di architettura e architettura d'interni a Roma. Progettazione residenziale, ristrutturazioni, recupero filologico e spazi su misura."
>
  <!-- 1. HERO SECTION -->
  <section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 lg:pt-24 lg:pb-36 border-b border-[#E2DBD0] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Top coordinates & index -->
      <div class="flex items-center justify-between font-mono text-xs text-[#77756E] pb-8 mb-8 border-b border-[#E2DBD0]/60">
        <span class="text-[#8A8D76]">[ ARCHITETTURA & INTERIOR DESIGN ]</span>
        <span>ROMA — VIA APUANIA 3</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-end">
        <!-- Left: Editorial Headline & Actions -->
        <div class="lg:col-span-7 space-y-8">
          <div class="space-y-4">
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-light tracking-tight text-[#292925] leading-[1.08]">
              Architettura, interni e spazi da vivere.
            </h1>
            <p class="text-lg sm:text-xl text-[#77756E] font-light max-w-xl leading-relaxed pt-2">
              Ascoltiamo le esigenze di chi abiterà gli spazi e le trasformiamo in progetti attenti, equilibrati e concreti.
            </p>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="/progetti"
              class="inline-flex items-center justify-center px-8 py-4 text-xs uppercase tracking-[0.18em] font-medium text-[#F8F7F4] bg-[#292925] hover:bg-[#383833] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925]"
            >
              <span>Esplora i progetti</span>
              <svg class="w-3.5 h-3.5 ml-2.5 text-[#D7CDBE]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </a>

            <a
              href="/contatti"
              class="inline-flex items-center justify-center px-8 py-4 text-xs uppercase tracking-[0.18em] font-medium text-[#292925] border border-[#292925] hover:bg-[#F1EFE9] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925]"
            >
              <span>Entra in contatto</span>
            </a>
          </div>

          <!-- Quick facts micro-list -->
          <div class="pt-8 border-t border-[#E2DBD0]/60 grid grid-cols-3 gap-4 font-mono text-xs">
            <div>
              <span class="text-[#8A8D76] block text-[10px] uppercase tracking-widest">[ FONDAZIONE ]</span>
              <span class="text-[#292925] font-medium text-sm">2013, Roma</span>
            </div>
            <div>
              <span class="text-[#8A8D76] block text-[10px] uppercase tracking-widest">[ RATING HOUZZ ]</span>
              <span class="text-[#292925] font-medium text-sm">4,9 / 5 (23 rec.)</span>
            </div>
            <div>
              <span class="text-[#8A8D76] block text-[10px] uppercase tracking-widest">[ AMBITO ]</span>
              <span class="text-[#292925] font-medium text-sm">Residenziale</span>
            </div>
          </div>
        </div>

        <!-- Right: LCP Hero Photography with Asymmetrical framing -->
        <div class="lg:col-span-5 relative">
          <div class="relative bg-[#F1EFE9] overflow-hidden aspect-[4/5] sm:aspect-[3/4] border border-[#E2DBD0]">
            <picture>
              <source srcset="/images/appartamento-mg-soggiorno.webp" type="image/webp" />
              <img
                src="/images/appartamento-mg-soggiorno.jpg"
                alt="Living open space di Casa MG curato da Appuntostudio a Roma"
                width="1828"
                height="1174"
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                class="w-full h-full object-cover object-center"
              />
            </picture>
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-[#292925]/80 via-[#292925]/30 to-transparent p-6 text-[#F8F7F4]">
              <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-[#D7CDBE] block">
                [ PROGETTO IN EVIDENZA ]
              </span>
              <p class="font-sans text-lg font-light">Casa MG — Ristrutturazione post-industriale</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. STUDIO PHILOSOPHY INTRO -->
  <section class="py-20 sm:py-28 bg-[#F1EFE9]/40 border-b border-[#E2DBD0]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-4">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#8A8D76] block mb-3">
            [ 01 / LA NOSTRA VISIONE ]
          </span>
          <h2 class="text-3xl sm:text-4xl font-light tracking-tight text-[#292925] leading-tight">
            La cerniera sensibile tra architettura e vita quotidiana.
          </h2>
        </div>

        <div class="lg:col-span-8 space-y-6 text-[#77756E] text-base sm:text-lg font-light leading-relaxed">
          <p class="text-[#292925] font-normal text-xl sm:text-2xl leading-snug">
            «Ogni progetto nasce dall’ascolto. Dalle prime analisi alla realizzazione, accompagniamo il committente in un percorso in cui architettura, interni e design dialogano per dare forma a spazi autentici e funzionali.»
          </p>
          <p>
            Fondato a Roma nel 2013 dagli architetti Angelo Paolino, Monica Molinaro e Rosella Cippone, e arricchito dal 2016 dall’esperienza artistica e progettuale del prof. arch. Alfredo Benedetti, lo studio copre tutte le necessità del processo progettuale: dall’indagine normativa al risanamento, dal restauro alla nuova edilizia.
          </p>
          <div class="pt-4">
            <a
              href="/studio"
              class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.16em] font-medium text-[#292925] hover:text-[#8A8D76] transition-colors pb-1 border-b border-[#292925]"
            >
              <span>Approfondisci la storia dello studio</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. FEATURED PROJECTS (EDITORIAL GRID) -->
  <section id="progetti-evidenza" class="py-20 sm:py-32 border-b border-[#E2DBD0]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between pb-12 mb-12 border-b border-[#E2DBD0] gap-6">
        <div>
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#8A8D76] block mb-2">
            [ 02 / SELEZIONE OPERE ]
          </span>
          <h2 class="text-3xl sm:text-5xl font-light tracking-tight text-[#292925]">
            Opere e interventi selezionati
          </h2>
        </div>
        <p class="text-sm sm:text-base text-[#77756E] font-light max-w-md">
          Cinque progetti distinti tra ristrutturazioni sartoriali a Roma e architettura residenziale contemporanea.
        </p>
      </div>

      <!-- Asymmetric Editorial Grid -->
      <!-- Project 1 (Full feature banner) -->
      <div class="mb-16">
        <article class="group grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-[#F1EFE9]/40 border border-[#E2DBD0] p-6 sm:p-10">
          <div class="lg:col-span-7 order-2 lg:order-1 space-y-6">
            <div class="flex items-center gap-3 font-mono text-xs text-[#77756E]">
              <span class="text-[#8A8D76]">[{featuredProjects[0].index}]</span>
              <span class="uppercase tracking-widest">{featuredProjects[0].category}</span>
              <span>•</span>
              <span>{featuredProjects[0].location}</span>
            </div>

            <h3 class="text-3xl sm:text-4xl font-light tracking-tight text-[#292925] group-hover:text-[#8A8D76] transition-colors">
              <a href={`/progetti/${featuredProjects[0].slug}`}>
                {featuredProjects[0].title}
              </a>
            </h3>

            <p class="text-[#77756E] text-base font-light leading-relaxed">
              {featuredProjects[0].editorialExcerpt}
            </p>

            <div class="pt-4 flex items-center justify-between border-t border-[#E2DBD0]">
              <a
                href={`/progetti/${featuredProjects[0].slug}`}
                class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.16em] font-medium text-[#292925] group-hover:translate-x-1 transition-transform"
              >
                <span>Vedi il progetto completo</span>
                <svg class="w-3.5 h-3.5 text-[#8A8D76]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <span class="font-mono text-xs text-[#8A8D76]">{featuredProjects[0].gallery.length} fotografie</span>
            </div>
          </div>

          <div class="lg:col-span-5 order-1 lg:order-2 overflow-hidden aspect-[4/3] bg-[#E2DBD0]">
            <a href={`/progetti/${featuredProjects[0].slug}`} class="block w-full h-full">
              <picture>
                <source srcset={featuredProjects[0].coverImage.webp} type="image/webp" />
                <img
                  src={featuredProjects[0].coverImage.src}
                  alt={featuredProjects[0].coverImage.alt}
                  width={featuredProjects[0].coverImage.width}
                  height={featuredProjects[0].coverImage.height}
                  loading="eager"
                  decoding="async"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                />
              </picture>
            </a>
          </div>
        </article>
      </div>

      <!-- Projects 2 & 3 (Two column pairing) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-12 mb-16">
        <ProjectCard project={featuredProjects[1]} />
        <ProjectCard project={featuredProjects[2]} />
      </div>

      <!-- Projects 4 & 5 (Two column pairing) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-12">
        <ProjectCard project={featuredProjects[3]} />
        <ProjectCard project={featuredProjects[4]} />
      </div>

      <!-- Bottom Portfolio CTA -->
      <div class="mt-16 pt-12 border-t border-[#E2DBD0] text-center">
        <a
          href="/progetti"
          class="inline-flex items-center justify-center px-10 py-5 text-xs uppercase tracking-[0.2em] font-medium text-[#F8F7F4] bg-[#292925] hover:bg-[#383833] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925]"
        >
          <span>Scopri tutti i progetti</span>
          <svg class="w-4 h-4 ml-3 text-[#D7CDBE]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. SERVICES SECTION -->
  <section class="py-20 sm:py-32 bg-[#F1EFE9]/40 border-b border-[#E2DBD0]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="pb-12 mb-12 border-b border-[#E2DBD0] flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#8A8D76] block mb-2">
            [ 03 / AMBITI OPERATIVI ]
          </span>
          <h2 class="text-3xl sm:text-5xl font-light tracking-tight text-[#292925]">
            Servizi di architettura
          </h2>
        </div>
        <p class="text-sm sm:text-base text-[#77756E] font-light max-w-md">
          Un approccio completo che integra tutte le fasi progettuali: dall’inquadramento normativo al disegno del dettaglio costruttivo.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {SERVICE_CATEGORIES.map((cat) => (
          <div class="bg-[#F8F7F4] border border-[#E2DBD0] p-6 sm:p-8 flex flex-col justify-between hover:border-[#8A8D76] transition-colors">
            <div>
              <div class="font-mono text-xs text-[#8A8D76] mb-4">
                [{cat.index}]
              </div>
              <h3 class="text-xl font-light text-[#292925] mb-3">
                {cat.title}
              </h3>
              <p class="text-xs sm:text-sm text-[#77756E] font-light leading-relaxed mb-6">
                {cat.description}
              </p>
            </div>

            <ul class="space-y-2 border-t border-[#E2DBD0] pt-4 text-xs text-[#292925] font-light">
              {cat.items.map(item => (
                <li class="flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-[#8A8D76]" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href="/servizi"
          class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.16em] font-medium text-[#292925] hover:text-[#8A8D76] transition-colors pb-1 border-b border-[#292925]"
        >
          <span>Visualizza l'elenco completo dei 18 servizi</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. REVIEWS & TESTIMONIALS SECTION (HOUZZ VERIFIED) -->
  <section class="py-20 sm:py-32 border-b border-[#E2DBD0]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header with Houzz Aggregated Rating Badge -->
      <div class="pb-12 mb-12 border-b border-[#E2DBD0] flex flex-col lg:flex-row lg:items-end justify-between gap-8">
        <div>
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#8A8D76] block mb-2">
            [ 04 / TESTIMONIANZE ]
          </span>
          <h2 class="text-3xl sm:text-5xl font-light tracking-tight text-[#292925]">
            La voce dei committenti
          </h2>
          <p class="mt-3 text-sm sm:text-base text-[#77756E] font-light max-w-xl">
            Esperienze dirette di proprietari, clienti continuativi e colleghi professionisti che hanno collaborato con il nostro team.
          </p>
        </div>

        <!-- Houzz Aggregated Verified Badge -->
        <div class="bg-[#F1EFE9] border border-[#E2DBD0] p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-6 max-w-md">
          <div>
            <div class="flex items-baseline gap-2">
              <span class="font-sans text-3xl font-light text-[#292925]">{REVIEWS_META.average}</span>
              <span class="font-mono text-sm text-[#77756E]">/ {REVIEWS_META.maxScore}</span>
            </div>
            <div class="font-mono text-xs text-[#8A8D76] mt-1">
              {REVIEWS_META.totalCount} recensioni verificate su {REVIEWS_META.platform}
            </div>
          </div>

          <a
            href={REVIEWS_META.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-4 py-2.5 text-xs uppercase tracking-[0.14em] font-medium bg-[#292925] text-[#F8F7F4] hover:bg-[#383833] transition-colors"
          >
            <span>Leggi su Houzz</span>
            <svg class="w-3 h-3 ml-1.5 text-[#D7CDBE]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        </div>
      </div>

      <!-- The 6 Verified Reviews in 2-column editorial grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {REVIEWS.map((rev, idx) => (
          <ReviewCard review={rev} index={idx} />
        ))}
      </div>

      <div class="mt-8 text-center text-xs font-mono text-[#77756E]">
        * Tutte le sei testimonianze riportate corrispondono a recensioni autentiche con valutazione individuale di 5/5 pubblicate sul profilo pubblico di Appuntostudio.
      </div>
    </div>
  </section>
</BaseLayout>
