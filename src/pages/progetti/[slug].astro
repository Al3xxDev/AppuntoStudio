---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { PROJECTS, getAdjacentProjects } from '../../data/projects';
import type { Project } from '../../data/projects';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { prev, next } = getAdjacentProjects(project.slug);

// Split gallery into regular photos and plan(s)
const photos = project.gallery.filter(img => !img.isPlan);
const plans = project.gallery.filter(img => img.isPlan);

// Varied layout: first image full-width; then pairs of landscape or portrait+landscape
const galleryWithLayout: Array<{ img: typeof photos[0]; span: 'full' | 'wide' | 'narrow' | 'portrait' }> = [];
photos.forEach((img, i) => {
  if (i === 0) {
    galleryWithLayout.push({ img, span: 'full' });
  } else if (img.orientation === 'portrait' || (img.width < img.height)) {
    galleryWithLayout.push({ img, span: 'portrait' });
  } else {
    galleryWithLayout.push({ img, span: 'wide' });
  }
});
---

<BaseLayout
  title={`${project.title} — ${project.category} | Appuntostudio Roma`}
  description={`${project.title}: ${project.subtitle}. Progetto a cura di Appuntostudio, architettura e interni a Roma.`}
  image={project.coverImage.webp}
  type="article"
>
  <article class="pt-8 pb-24 sm:pt-16 sm:pb-36">

    <!-- Page Entrance Sequence -->
    <div data-page-entrance>
      <!-- Breadcrumb -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
        <nav class="relative pb-6" aria-label="Percorso di navigazione">
          <div data-entrance-breadcrumb class="flex items-center gap-2 font-mono text-xs text-[#77756E]">
            <a href="/" class="hover:text-[#292925] transition-colors">Home</a>
            <span aria-hidden="true">/</span>
            <a href="/progetti" class="hover:text-[#292925] transition-colors">Progetti</a>
            <span aria-hidden="true">/</span>
            <span class="text-[#8A8D76]" aria-current="page">{project.title}</span>
          </div>
          <span data-rule-reveal class="block absolute bottom-0 inset-x-0 h-px bg-[#E2DBD0] origin-left" aria-hidden="true"></span>
        </nav>
      </div>

      <!-- 1. Project Header -->
      <header class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12 sm:mb-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
          <div class="lg:col-span-8 space-y-4">
            <div data-entrance-eyebrow class="flex items-center gap-3 font-mono text-xs text-[#8A8D76]">
              <span class="uppercase tracking-widest">{project.category}</span>
              {project.year && (
                <>
                  <span class="text-[#E2DBD0]">•</span>
                  <span class="text-[#77756E]">{project.year}</span>
                </>
              )}
              <span class="text-[#E2DBD0]">•</span>
              <span class="text-[#77756E]">{project.location}</span>
            </div>

            <h1 data-entrance-title class="text-4xl sm:text-6xl lg:text-7xl font-light tracking-tight text-[#292925] leading-[1.08]">
              {project.title}
            </h1>

            <p data-entrance-copy class="text-xl sm:text-2xl text-[#77756E] font-light leading-relaxed max-w-2xl pt-2">
              {project.subtitle}
            </p>
          </div>

          <!-- Technical Specs Card: Soft, Clean & Refined -->
          <div data-entrance-specs class="lg:col-span-4 rounded-[14px] bg-white border border-[#E2DBD0]/90 p-5 sm:p-6 space-y-3 font-mono text-xs shadow-[0_2px_12px_rgba(41,41,37,0.03)]">
            <div class="relative text-[#8A8D76] uppercase tracking-widest text-[10px] pb-2 flex items-center justify-between">
              <span>Scheda Tecnica</span>
              <span class="text-[#77756E]">{project.location}</span>
              <span data-rule-reveal class="block absolute bottom-0 inset-x-0 h-px bg-[#E2DBD0]/70 origin-left" aria-hidden="true"></span>
            </div>
            {project.specs.map(spec => (
              <div data-spec-row class="flex justify-between gap-4 py-1 border-b border-[#E2DBD0]/40 last:border-b-0">
                <span class="text-[#77756E]">{spec.label}:</span>
                <span class="text-[#292925] text-right font-sans font-light">{spec.value}</span>
              </div>
            ))}
          </div>
        </div>
      </header>

      <!-- 2. Hero Cover — Cinematic Opening Photography with Soft Rounded Corners -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 sm:mb-24">
        <div data-entrance-photo class="group">
          <div class="relative w-full overflow-hidden rounded-[14px] sm:rounded-[20px] bg-[#EAE6DF] border border-[#E2DBD0]/90 shadow-[0_6px_30px_-8px_rgba(41,41,37,0.07)]">
            <div data-scroll-photo data-scroll-variant="hero" class="relative w-full aspect-[16/9] sm:aspect-[21/9] overflow-hidden">
              <picture>
                <source srcset={project.coverImage.webp} type="image/webp" />
                <img
                  src={project.coverImage.src}
                  alt={project.coverImage.alt}
                  width={project.coverImage.width}
                  height={project.coverImage.height}
                  loading="eager"
                  fetchpriority="high"
                  decoding="sync"
                  class="scroll-photo-img w-full h-full object-cover object-center"
                />
              </picture>
            </div>
          </div>

          <!-- Caption Under Hero Photo -->
          <div data-card-caption class="mt-3.5 flex items-center justify-between text-xs text-[#77756E] font-light">
            <span>{project.title} — {project.subtitle}</span>
            <span class="font-mono text-[11px] text-[#8A8D76] uppercase tracking-wider">{project.location}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Project Narrative -->
    <section data-scroll-section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-20 sm:mb-28">
      <div class="relative pt-10 sm:pt-14">
        <span data-rule-reveal class="block absolute top-0 inset-x-0 h-px bg-[#E2DBD0] origin-left" aria-hidden="true"></span>
        <span data-reveal-eyebrow class="font-mono text-xs uppercase tracking-[0.2em] text-[#8A8D76] block mb-4">
          Il Progetto
        </span>
        <h2 data-split-heading class="text-2xl sm:text-3xl font-light tracking-tight text-[#292925] mb-8">
          Relazione e scelte architettoniche
        </h2>
        <div class="space-y-6 text-base sm:text-lg text-[#383833] font-light leading-relaxed">
          {project.description.map((paragraph) => (
            <p data-reveal-copy>{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Editorial Photo Gallery -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20 sm:mb-32">
      <div data-scroll-section class="relative flex items-baseline justify-between pb-6 mb-10">
        <div>
          <span data-reveal-eyebrow class="font-mono text-xs uppercase tracking-[0.2em] text-[#8A8D76] block mb-1">
            Documentazione Fotografica
          </span>
          <h2 data-split-heading class="text-2xl sm:text-4xl font-light tracking-tight text-[#292925]">
            Spazi e dettagli ({photos.length} fotografie)
          </h2>
        </div>
        <span data-reveal-item class="font-mono text-xs text-[#77756E] hidden sm:block">
          Clicca per ingrandire
        </span>
        <span data-rule-reveal class="block absolute bottom-0 inset-x-0 h-px bg-[#E2DBD0] origin-left" aria-hidden="true"></span>
      </div>

      <!-- Editorial Photo Gallery Layout -->
      {galleryWithLayout.length > 0 && (
        <div class="space-y-8 sm:space-y-12">

          <!-- First image: Full-width cinematic photo -->
          {galleryWithLayout[0] && (
            <div data-project-card class="group">
              <button
                type="button"
                data-lightbox-trigger
                data-src={galleryWithLayout[0].img.webp}
                data-alt={galleryWithLayout[0].img.alt}
                data-caption={galleryWithLayout[0].img.caption || galleryWithLayout[0].img.alt}
                class="block w-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925] cursor-zoom-in"
                aria-label={`Ingrandisci: ${galleryWithLayout[0].img.alt}`}
              >
                <div data-scroll-photo data-scroll-variant="panorama" class="relative w-full overflow-hidden rounded-[14px] sm:rounded-[18px] bg-[#EAE6DF] border border-[#E2DBD0]/90 shadow-[0_4px_24px_-4px_rgba(41,41,37,0.06)] group-hover:shadow-[0_14px_34px_-6px_rgba(41,41,37,0.1)] group-hover:border-[#D5CEC2] transition-[border-color,box-shadow] duration-500 aspect-[16/9] sm:aspect-[21/9]">
                  <picture>
                    <source srcset={galleryWithLayout[0].img.webp} type="image/webp" />
                    <img
                      src={galleryWithLayout[0].img.src}
                      alt={galleryWithLayout[0].img.alt}
                      width={galleryWithLayout[0].img.width}
                      height={galleryWithLayout[0].img.height}
                      loading="eager"
                      decoding="async"
                      class="scroll-photo-img w-full h-full object-cover object-center"
                    />
                  </picture>
                  <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/3 transition-colors duration-500" aria-hidden="true" />
                </div>
              </button>
              <div data-card-caption class="mt-3 flex items-center justify-between text-xs text-[#77756E] font-light">
                <p class="truncate max-w-[80%] text-[13px]">{galleryWithLayout[0].img.caption || galleryWithLayout[0].img.alt}</p>
                <span class="inline-flex items-center gap-1 font-mono text-[11px] text-[#8A8D76] group-hover:text-[#292925] transition-colors shrink-0">
                  <span>Ingrandisci</span>
                  <span class="inline-block transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
                </span>
              </div>
            </div>
          )}

          <!-- Remaining photos: alternating editorial compositions -->
          {galleryWithLayout.length > 1 && (() => {
            const rest = galleryWithLayout.slice(1);
            const groups: typeof rest[] = [];
            let i = 0;
            while (i < rest.length) {
              const curr = rest[i];
              const next2 = rest[i + 1];
              if (curr.span === 'portrait' && next2 && next2.span !== 'portrait') {
                groups.push([curr, next2]);
                i += 2;
              } else if (curr.span !== 'portrait' && next2 && next2.span === 'portrait') {
                groups.push([curr, next2]);
                i += 2;
              } else if (next2) {
                groups.push([curr, next2]);
                i += 2;
              } else {
                groups.push([curr]);
                i += 1;
              }
            }
            return groups.map((group) => (
              <div
                data-project-diptych
                class:list={[
                  'grid gap-6 sm:gap-8',
                  group.length === 1 ? 'grid-cols-1' :
                  group.some(g => g.span === 'portrait')
                    ? 'grid-cols-1 md:grid-cols-[3fr_2fr] lg:grid-cols-[2fr_1fr]'
                    : 'grid-cols-1 md:grid-cols-2',
                ]}
              >
                {group.map((item) => {
                  const isPortrait = item.span === 'portrait';
                  return (
                    <div data-project-card class="group flex flex-col justify-between">
                      <button
                        type="button"
                        data-lightbox-trigger
                        data-src={item.img.webp}
                        data-alt={item.img.alt}
                        data-caption={item.img.caption || item.img.alt}
                        class="block w-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925] cursor-zoom-in"
                        aria-label={`Ingrandisci fotografia: ${item.img.alt}`}
                      >
                        <div
                          data-scroll-photo
                          data-scroll-variant={isPortrait ? 'portrait' : 'landscape'}
                          class:list={[
                            'relative w-full overflow-hidden rounded-[12px] sm:rounded-[16px] bg-[#EAE6DF] border border-[#E2DBD0]/90 shadow-[0_2px_14px_rgba(41,41,37,0.04)] group-hover:shadow-[0_12px_30px_-6px_rgba(41,41,37,0.09)] group-hover:border-[#D5CEC2] transition-[border-color,box-shadow] duration-500',
                            group.length === 1 ? 'aspect-[16/9]' :
                            isPortrait ? 'aspect-[3/4]' : 'aspect-[4/3]',
                          ]}
                        >
                          <picture>
                            <source srcset={item.img.webp} type="image/webp" />
                            <img
                              src={item.img.src}
                              alt={item.img.alt}
                              width={item.img.width}
                              height={item.img.height}
                              loading="eager"
                              decoding="async"
                              class="scroll-photo-img w-full h-full object-cover object-center"
                            />
                          </picture>
                          <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/3 transition-colors duration-500" aria-hidden="true" />
                        </div>
                      </button>
                      <div data-card-caption class="mt-2.5 flex items-center justify-between text-xs text-[#77756E] font-light">
                        <p class="truncate max-w-[80%] text-[13px]">
                          {item.img.caption || item.img.alt}
                        </p>
                        <span class="inline-flex items-center gap-1 font-mono text-[10px] text-[#8A8D76] group-hover:text-[#292925] transition-colors shrink-0 ml-2">
                          <span>Zoom</span>
                          <span class="inline-block transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
                        </span>
                      </div>
                    </div>
                  );
                })}
              </div>
            ));
          })()}
        </div>
      )}

      <!-- Technical Drawings: CAD Plans (clean sheet style) -->
      {plans.length > 0 && (
        <div data-scroll-section class="relative mt-16 sm:mt-24 pt-10">
          <span data-rule-reveal class="block absolute top-0 inset-x-0 h-px bg-[#E2DBD0] origin-left" aria-hidden="true"></span>
          <span data-reveal-eyebrow class="font-mono text-xs uppercase tracking-[0.2em] text-[#8A8D76] block mb-6">
            Planimetria e Tavole di Progetto
          </span>
          <div class="space-y-6">
            {plans.map((img) => (
              <div data-reveal-item class="rounded-[14px] sm:rounded-[18px] bg-white border border-[#E2DBD0]/90 p-4 sm:p-6 shadow-[0_2px_12px_rgba(41,41,37,0.03)] group">
                <div class="flex items-center justify-between font-mono text-xs text-[#77756E] pb-3 border-b border-[#E2DBD0]/70 mb-3">
                  <span class="text-[#8A8D76] uppercase tracking-wider">{project.title} — Planimetria generale</span>
                  <span class="text-[#292925]">Scala 1:100</span>
                </div>
                <button
                  type="button"
                  data-lightbox-trigger
                  data-src={img.webp}
                  data-alt={img.alt}
                  data-caption={img.caption || img.alt}
                  class="block w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925] cursor-zoom-in"
                  aria-label={`Ingrandisci tavola tecnica: ${img.alt}`}
                >
                  <div class="bg-white overflow-hidden aspect-[2.4/1] sm:aspect-[3/1]">
                    <picture>
                      <source srcset={img.webp} type="image/webp" />
                      <img
                        src={img.src}
                        alt={img.alt}
                        width={img.width}
                        height={img.height}
                        loading="eager"
                        decoding="async"
                        class="w-full h-full object-contain p-2 sm:p-4 group-hover:scale-[1.015] transition-transform duration-500"
                      />
                    </picture>
                  </div>
                </button>
                <div class="mt-3 pt-2 border-t border-[#E2DBD0]/70 flex items-center justify-between text-xs text-[#77756E] font-light">
                  <p class="text-[13px] truncate max-w-[80%]">{img.caption || img.alt}</p>
                  <span class="font-mono text-[10px] text-[#8A8D76] uppercase tracking-wider group-hover:text-[#292925] transition-colors">
                    Visualizza tavola ↗
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- 5. Adjacent Projects Navigation: Clean & Soft -->
    <nav data-scroll-section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-8" aria-label="Navigazione tra progetti">
      <span data-rule-reveal class="block absolute top-0 inset-x-4 sm:inset-x-6 lg:inset-x-8 h-px bg-[#E2DBD0] origin-left" aria-hidden="true"></span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- Prev Project -->
        <a
          href={`/progetti/${prev.slug}`}
          data-reveal-item
          class="group rounded-[14px] sm:rounded-[16px] bg-[#F8F7F4] border border-[#E2DBD0]/90 p-6 sm:p-8 hover:border-[#8A8D76] hover:bg-white hover:-translate-y-0.5 transition-all duration-300 shadow-[0_2px_12px_rgba(41,41,37,0.02)] hover:shadow-[0_10px_28px_-6px_rgba(41,41,37,0.08)]"
        >
          <span class="font-mono text-xs text-[#8A8D76] inline-flex items-center gap-1.5 mb-2">
            <span class="inline-block transition-transform duration-300 group-hover:-translate-x-1" aria-hidden="true">←</span>
            <span>Progetto precedente</span>
          </span>
          <span class="text-xl sm:text-2xl font-light text-[#292925] group-hover:text-[#8A8D76] transition-colors block">
            {prev.title}
          </span>
          <span class="text-xs text-[#77756E] font-light mt-1 block">{prev.subtitle}</span>
        </a>

        <!-- Next Project -->
        <a
          href={`/progetti/${next.slug}`}
          data-reveal-item
          class="group rounded-[14px] sm:rounded-[16px] bg-[#F8F7F4] border border-[#E2DBD0]/90 p-6 sm:p-8 hover:border-[#8A8D76] hover:bg-white hover:-translate-y-0.5 transition-all duration-300 shadow-[0_2px_12px_rgba(41,41,37,0.02)] hover:shadow-[0_10px_28px_-6px_rgba(41,41,37,0.08)] text-left sm:text-right"
        >
          <span class="font-mono text-xs text-[#8A8D76] inline-flex items-center sm:justify-end gap-1.5 mb-2">
            <span>Progetto successivo</span>
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </span>
          <span class="text-xl sm:text-2xl font-light text-[#292925] group-hover:text-[#8A8D76] transition-colors block">
            {next.title}
          </span>
          <span class="text-xs text-[#77756E] font-light mt-1 block">{next.subtitle}</span>
        </a>
      </div>

      <div data-reveal-item class="text-center mt-10">
        <a
          href="/progetti"
          data-editorial-link
          class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#77756E] hover:text-[#292925] transition-colors"
        >
          <span data-editorial-label>Torna all'archivio dei progetti</span>
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </nav>
  </article>

  <!-- Mount Lightbox Modal -->
  <Lightbox />
</BaseLayout>
