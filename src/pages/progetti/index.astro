---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECTS } from '../../data/projects';

const [gracchi, mg, jd, fp, villa] = PROJECTS;
---

<BaseLayout
  title="Progetti — Appuntostudio Architettura Roma"
  description="Esplora i progetti realizzati da Appuntostudio: ristrutturazioni residenziali di pregio a Roma e architettura su misura."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24 sm:pt-20 sm:pb-36">
    <!-- Breadcrumb & Index Header -->
    <div class="flex items-center gap-2 font-mono text-xs text-[#77756E] pb-6 mb-8 border-b border-[#E2DBD0]">
      <a href="/" class="hover:text-[#292925] transition-colors">Home</a>
      <span>/</span>
      <span class="text-[#8A8D76]">[02 / ARCHIVIO PROGETTI]</span>
    </div>

    <!-- Editorial Header -->
    <div class="max-w-3xl mb-16 sm:mb-24">
      <h1 class="text-4xl sm:text-6xl font-light tracking-tight text-[#292925] leading-tight">
        Opere, ristrutturazioni e architettura d’interni.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-[#77756E] font-light leading-relaxed">
        Una selezione di interventi in cui il rigore geometrico incontra la sensibilità materica. Ogni progetto risponde a un programma specifico, valorizzando la luce naturale e l’identità autentica del luogo.
      </p>
    </div>

    <!-- Editorial Project Sequence -->
    <div class="space-y-24 sm:space-y-36">

      <!-- 1. TAVOLA 01: CASA GRACCHI (Protagonist Monograph Spread) -->
      <article class="border-t border-[#E2DBD0] pt-10 sm:pt-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <!-- Text column -->
          <div class="lg:col-span-5 space-y-6">
            <div class="flex items-center gap-3 font-mono text-xs text-[#77756E]">
              <span class="text-[#8A8D76]">[{gracchi.index}]</span>
              <span class="uppercase tracking-widest">{gracchi.category}</span>
              <span>•</span>
              <span>{gracchi.location}</span>
            </div>

            <h2 class="text-3xl sm:text-5xl font-light tracking-tight text-[#292925] hover:text-[#8A8D76] transition-colors">
              <a href={`/progetti/${gracchi.slug}`}>
                {gracchi.title}
              </a>
            </h2>

            <p class="text-base sm:text-lg text-[#77756E] font-light leading-relaxed">
              {gracchi.editorialExcerpt}
            </p>

            <!-- Specs Plaque -->
            <div class="py-4 border-y border-[#D7CDBE]/70 space-y-2 font-mono text-xs text-[#77756E]">
              {gracchi.specs.slice(0, 3).map(spec => (
                <div class="flex justify-between gap-4">
                  <span class="text-[#8A8D76] uppercase tracking-wider">{spec.label}:</span>
                  <span class="text-[#292925] text-right font-sans text-xs">{spec.value}</span>
                </div>
              ))}
            </div>

            <div class="pt-2">
              <a
                href={`/progetti/${gracchi.slug}`}
                class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] font-medium text-[#292925] hover:text-[#8A8D76] hover:translate-x-1 transition-all pb-1 border-b border-[#292925]"
              >
                <span>Vedi scheda e tavole ({gracchi.gallery.length} foto)</span>
                <svg class="w-3.5 h-3.5 text-[#8A8D76]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Exhibition Plate with Passe-Partout -->
          <div class="lg:col-span-7">
            <div class="relative bg-[#F4F1EA] border border-[#D7CDBE] p-3.5 sm:p-6 lg:p-7 group shadow-[0_2px_12px_rgba(41,41,37,0.03)] hover:border-[#8A8D76] transition-all duration-300">
              <!-- Corner Crosshairs -->
              <div class="pointer-events-none select-none" aria-hidden="true">
                <span class="absolute top-2 left-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute top-2 right-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute bottom-2 left-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute bottom-2 right-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
              </div>

              <!-- Floating Tag -->
              <div class="absolute -top-3 left-4 z-10 px-2.5 py-0.5 bg-[#292925] text-[#F8F7F4] font-mono text-[9px] uppercase tracking-widest border border-[#292925] shadow-xs select-none">
                TAV. 01 / VISTA D'INSIEME
              </div>

              <a
                href={`/progetti/${gracchi.slug}`}
                class="block relative bg-[#EAE6DF] border border-[#292925]/10 rounded-[2px] overflow-hidden aspect-[16/10] sm:aspect-[3/2] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925]"
                aria-label={`Apri scheda ${gracchi.title}`}
              >
                <picture>
                  <source srcset={gracchi.coverImage.webp} type="image/webp" />
                  <img
                    src={gracchi.coverImage.src}
                    alt={gracchi.coverImage.alt}
                    width={gracchi.coverImage.width}
                    height={gracchi.coverImage.height}
                    loading="eager"
                    decoding="sync"
                    class="w-full h-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-700 ease-out"
                  />
                </picture>
                <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/4 transition-colors duration-300" aria-hidden="true" />
              </a>

              <!-- Integrated Bottom Plaque -->
              <div class="mt-3 pt-2.5 border-t border-[#D7CDBE]/70 flex items-center justify-between text-xs font-mono">
                <span class="text-[#77756E] text-[11px] truncate">
                  CASA GRACCHI — ZONA LIVING CON LIBRERIA SCULTOREA
                </span>
                <span class="text-[#8A8D76] text-[10px] uppercase tracking-wider shrink-0 ml-2">
                  ROMA (VATICANO)
                </span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- 2. DITTICO ASIMMETRICO: CASA MG (Landscape) & CASA JD (Portrait) -->
      <div class="border-t border-[#E2DBD0] pt-12 sm:pt-20">
        <div class="mb-10 max-w-xl">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#8A8D76] block mb-2">
            [ TAVOLE COMPARATIVE / DITTICO RESIDENZIALE ]
          </span>
          <p class="text-sm font-light text-[#77756E]">
            Due interpretazioni dell’abitare a Roma: dal rigore post-industriale della grande distribuzione al recupero del purismo neoclassico valaderiano.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
          <!-- Casa MG: Landscape Architectural Plate (7 cols) -->
          <article class="lg:col-span-7 group flex flex-col justify-between">
            <div class="relative bg-[#F4F1EA] border border-[#D7CDBE] p-3.5 sm:p-5 group-hover:border-[#8A8D76] transition-all duration-300 shadow-[0_1px_4px_rgba(41,41,37,0.03)]">
              <!-- Corner Crosshairs -->
              <div class="pointer-events-none select-none" aria-hidden="true">
                <span class="absolute top-1.5 left-2 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute top-1.5 right-2 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute bottom-1.5 left-2 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute bottom-1.5 right-2 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
              </div>

              <!-- Floating Tag -->
              <div class="absolute -top-3 left-4 z-10 px-2.5 py-0.5 bg-[#292925] text-[#F8F7F4] font-mono text-[9px] uppercase tracking-widest border border-[#292925] shadow-xs select-none">
                TAV. 02 / RESIDENZIALE
              </div>

              <a
                href={`/progetti/${mg.slug}`}
                class="block relative bg-[#EAE6DF] border border-[#292925]/10 rounded-[2px] overflow-hidden aspect-[16/10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925]"
                aria-label={`Apri scheda ${mg.title}`}
              >
                <picture>
                  <source srcset={mg.coverImage.webp} type="image/webp" />
                  <img
                    src={mg.coverImage.src}
                    alt={mg.coverImage.alt}
                    width={mg.coverImage.width}
                    height={mg.coverImage.height}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-700 ease-out"
                  />
                </picture>
                <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/4 transition-colors duration-300" aria-hidden="true" />
              </a>

              <div class="mt-3 pt-2.5 border-t border-[#D7CDBE]/70 flex items-center justify-between text-xs font-mono">
                <span class="text-[#77756E] text-[11px] truncate">
                  CASA MG — PARETE SCORREVOLE IN FERRO E ROVERE
                </span>
                <span class="text-[#8A8D76] text-[10px] uppercase tracking-wider shrink-0 ml-2">
                  {mg.gallery.length} FOTO
                </span>
              </div>
            </div>

            <!-- Content below plate -->
            <div class="mt-5 space-y-3">
              <div class="flex items-center gap-2 font-mono text-xs text-[#77756E]">
                <span class="text-[#8A8D76]">[{mg.index}]</span>
                <span class="uppercase tracking-widest">{mg.category}</span>
                <span>•</span>
                <span>{mg.location}</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-light text-[#292925] group-hover:text-[#8A8D76] transition-colors">
                <a href={`/progetti/${mg.slug}`}>{mg.title}</a>
              </h3>
              <p class="text-sm sm:text-base text-[#77756E] font-light leading-relaxed">
                {mg.editorialExcerpt}
              </p>
              <div class="pt-2">
                <a
                  href={`/progetti/${mg.slug}`}
                  class="inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.16em] font-medium text-[#292925] group-hover:translate-x-1 transition-transform"
                >
                  <span>Esplora scheda intervento</span>
                  <span class="text-[#8A8D76]">→</span>
                </a>
              </div>
            </div>
          </article>

          <!-- Casa JD: Vertical Portrait Plate with Staggered Offset (5 cols) -->
          <article class="lg:col-span-5 lg:pt-8 group flex flex-col justify-between">
            <div class="relative bg-[#F4F1EA] border border-[#D7CDBE] p-3.5 sm:p-5 group-hover:border-[#8A8D76] transition-all duration-300 shadow-[0_1px_4px_rgba(41,41,37,0.03)]">
              <!-- Corner Crosshairs -->
              <div class="pointer-events-none select-none" aria-hidden="true">
                <span class="absolute top-1.5 left-2 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute top-1.5 right-2 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute bottom-1.5 left-2 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute bottom-1.5 right-2 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
              </div>

              <!-- Floating Tag -->
              <div class="absolute -top-3 left-4 z-10 px-2.5 py-0.5 bg-[#292925] text-[#F8F7F4] font-mono text-[9px] uppercase tracking-widest border border-[#292925] shadow-xs select-none">
                TAV. 03 / GALLERIA ABITATA
              </div>

              <a
                href={`/progetti/${jd.slug}`}
                class="block relative bg-[#EAE6DF] border border-[#292925]/10 rounded-[2px] overflow-hidden aspect-[4/5] sm:aspect-[3/4] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925]"
                aria-label={`Apri scheda ${jd.title}`}
              >
                <picture>
                  <source srcset={jd.coverImage.webp} type="image/webp" />
                  <img
                    src={jd.coverImage.src}
                    alt={jd.coverImage.alt}
                    width={jd.coverImage.width}
                    height={jd.coverImage.height}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-700 ease-out"
                  />
                </picture>
                <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/4 transition-colors duration-300" aria-hidden="true" />
              </a>

              <div class="mt-3 pt-2.5 border-t border-[#D7CDBE]/70 flex items-center justify-between text-xs font-mono">
                <span class="text-[#77756E] text-[11px] truncate">
                  CASA JD — GALLERIA NEOCLASSICA E GRES CALACATTA
                </span>
                <span class="text-[#8A8D76] text-[10px] uppercase tracking-wider shrink-0 ml-2">
                  ROMA (NOMENTANO)
                </span>
              </div>
            </div>

            <!-- Content below plate -->
            <div class="mt-5 space-y-3">
              <div class="flex items-center gap-2 font-mono text-xs text-[#77756E]">
                <span class="text-[#8A8D76]">[{jd.index}]</span>
                <span class="uppercase tracking-widest">{jd.category}</span>
                <span>•</span>
                <span>{jd.location}</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-light text-[#292925] group-hover:text-[#8A8D76] transition-colors">
                <a href={`/progetti/${jd.slug}`}>{jd.title}</a>
              </h3>
              <p class="text-sm sm:text-base text-[#77756E] font-light leading-relaxed">
                {jd.editorialExcerpt}
              </p>
              <div class="pt-2">
                <a
                  href={`/progetti/${jd.slug}`}
                  class="inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.16em] font-medium text-[#292925] group-hover:translate-x-1 transition-transform"
                >
                  <span>Esplora scheda intervento</span>
                  <span class="text-[#8A8D76]">→</span>
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>

      <!-- 3. TAVOLA 04: CASA FP (Dual Plate: Photo & Architectural CAD Study) -->
      <article class="border-t border-[#E2DBD0] pt-12 sm:pt-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <!-- Text Column -->
          <div class="lg:col-span-5 space-y-6">
            <div class="flex items-center gap-3 font-mono text-xs text-[#77756E]">
              <span class="text-[#8A8D76]">[{fp.index}]</span>
              <span class="uppercase tracking-widest">{fp.category}</span>
              <span>•</span>
              <span>{fp.location}</span>
            </div>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light tracking-tight text-[#292925] hover:text-[#8A8D76] transition-colors">
              <a href={`/progetti/${fp.slug}`}>{fp.title}</a>
            </h2>

            <p class="text-base sm:text-lg text-[#77756E] font-light leading-relaxed">
              {fp.editorialExcerpt}
            </p>

            <div class="py-4 border-y border-[#D7CDBE]/70 space-y-2 font-mono text-xs text-[#77756E]">
              {fp.specs.slice(0, 3).map(spec => (
                <div class="flex justify-between gap-4">
                  <span class="text-[#8A8D76] uppercase tracking-wider">{spec.label}:</span>
                  <span class="text-[#292925] text-right font-sans text-xs">{spec.value}</span>
                </div>
              ))}
            </div>

            <div class="pt-2">
              <a
                href={`/progetti/${fp.slug}`}
                class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] font-medium text-[#292925] hover:text-[#8A8D76] hover:translate-x-1 transition-all pb-1 border-b border-[#292925]"
              >
                <span>Vedi scheda e tavole ({fp.gallery.length} foto)</span>
                <svg class="w-3.5 h-3.5 text-[#8A8D76]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Dual Plate (Lounge Photo + CAD Floor Plan Miniature) -->
          <div class="lg:col-span-7 space-y-4">
            <!-- Main Photo Plate -->
            <div class="relative bg-[#F4F1EA] border border-[#D7CDBE] p-3.5 sm:p-6 group shadow-[0_2px_12px_rgba(41,41,37,0.03)] hover:border-[#8A8D76] transition-all duration-300">
              <!-- Corner Crosshairs -->
              <div class="pointer-events-none select-none" aria-hidden="true">
                <span class="absolute top-2 left-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute top-2 right-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute bottom-2 left-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
                <span class="absolute bottom-2 right-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
              </div>

              <!-- Floating Tag -->
              <div class="absolute -top-3 left-4 z-10 px-2.5 py-0.5 bg-[#292925] text-[#F8F7F4] font-mono text-[9px] uppercase tracking-widest border border-[#292925] shadow-xs select-none">
                TAV. 04 / SALONE E VETRATA MONUMENTALE
              </div>

              <a
                href={`/progetti/${fp.slug}`}
                class="block relative bg-[#EAE6DF] border border-[#292925]/10 rounded-[2px] overflow-hidden aspect-[16/10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925]"
                aria-label={`Apri scheda ${fp.title}`}
              >
                <picture>
                  <source srcset={fp.coverImage.webp} type="image/webp" />
                  <img
                    src={fp.coverImage.src}
                    alt={fp.coverImage.alt}
                    width={fp.coverImage.width}
                    height={fp.coverImage.height}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-700 ease-out"
                  />
                </picture>
                <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/4 transition-colors duration-300" aria-hidden="true" />
              </a>

              <div class="mt-3 pt-2.5 border-t border-[#D7CDBE]/70 flex items-center justify-between text-xs font-mono">
                <span class="text-[#77756E] text-[11px] truncate">
                  CASA FP — VETRATA LIGNEA STORICA RESTAURATA (H 4 METRI)
                </span>
                <span class="text-[#8A8D76] text-[10px] uppercase tracking-wider shrink-0 ml-2">
                  ROMA
                </span>
              </div>
            </div>

            <!-- Inset CAD Drawing Plate Preview -->
            <div class="relative bg-white border-2 border-[#292925]/15 p-3 sm:p-4 shadow-xs">
              <div class="flex items-center justify-between font-mono text-[10px] text-[#77756E] pb-2 border-b border-[#292925]/10 mb-2">
                <span class="text-[#8A8D76] uppercase tracking-wider">[ TAVOLA TECNICA — PLANIMETRIA GENERALE ]</span>
                <span class="text-[#292925]">SCALA 1:100</span>
              </div>
              <div class="aspect-[2.4/1] w-full overflow-hidden bg-white">
                <picture>
                  <source srcset="/images/casa-fp-piantaProgetto.webp" type="image/webp" />
                  <img
                    src="/images/casa-fp-piantaProgetto.jpg"
                    alt="Planimetria di progetto di Casa FP con vuoto dinamico e parete curva"
                    width="960"
                    height="536"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-contain p-2"
                  />
                </picture>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- 4. TAVOLA 05: VILLA RESIDENZIALE (Monumental Panoramic Landscape Spread) -->
      <article class="border-t border-[#E2DBD0] pt-12 sm:pt-20">
        <div class="space-y-8">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div class="max-w-2xl space-y-3">
              <div class="flex items-center gap-3 font-mono text-xs text-[#77756E]">
                <span class="text-[#8A8D76]">[{villa.index}]</span>
                <span class="uppercase tracking-widest">{villa.category}</span>
                <span>•</span>
                <span>{villa.year}</span>
                <span>•</span>
                <span>{villa.location}</span>
              </div>
              <h2 class="text-3xl sm:text-5xl font-light tracking-tight text-[#292925] hover:text-[#8A8D76] transition-colors">
                <a href={`/progetti/${villa.slug}`}>{villa.title}</a>
              </h2>
              <p class="text-base sm:text-lg text-[#77756E] font-light leading-relaxed">
                {villa.editorialExcerpt}
              </p>
            </div>

            <div class="shrink-0">
              <a
                href={`/progetti/${villa.slug}`}
                class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] font-medium text-[#292925] hover:text-[#8A8D76] hover:translate-x-1 transition-all pb-1 border-b border-[#292925]"
              >
                <span>Vedi scheda completa e SPA ({villa.gallery.length} foto)</span>
                <span class="text-[#8A8D76]">→</span>
              </a>
            </div>
          </div>

          <!-- Panoramic Architectural Plate -->
          <div class="relative bg-[#F4F1EA] border border-[#D7CDBE] p-3.5 sm:p-6 lg:p-8 group shadow-[0_2px_14px_rgba(41,41,37,0.03)] hover:border-[#8A8D76] transition-all duration-300">
            <!-- Corner Crosshairs -->
            <div class="pointer-events-none select-none" aria-hidden="true">
              <span class="absolute top-2 left-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
              <span class="absolute top-2 right-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
              <span class="absolute bottom-2 left-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
              <span class="absolute bottom-2 right-2.5 font-mono text-[9px] text-[#8A8D76]/70 leading-none">+</span>
            </div>

            <!-- Floating Tag -->
            <div class="absolute -top-3 left-4 z-10 px-2.5 py-0.5 bg-[#292925] text-[#F8F7F4] font-mono text-[9px] uppercase tracking-widest border border-[#292925] shadow-xs select-none">
              TAV. 05 / ARCHITETTURA NEL PAESAGGIO
            </div>

            <a
              href={`/progetti/${villa.slug}`}
              class="block relative bg-[#EAE6DF] border border-[#292925]/10 rounded-[2px] overflow-hidden aspect-[16/9] sm:aspect-[2.3/1] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#292925]"
              aria-label={`Apri scheda ${villa.title}`}
            >
              <picture>
                <source srcset={villa.coverImage.webp} type="image/webp" />
                <img
                  src={villa.coverImage.src}
                  alt={villa.coverImage.alt}
                  width={villa.coverImage.width}
                  height={villa.coverImage.height}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-700 ease-out"
                />
              </picture>
              <div class="absolute inset-0 bg-[#292925]/0 group-hover:bg-[#292925]/4 transition-colors duration-300" aria-hidden="true" />
            </a>

            <!-- Integrated Bottom Plaque with specs -->
            <div class="mt-3.5 pt-2.5 border-t border-[#D7CDBE]/70 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-mono">
              <span class="text-[#77756E] text-[11px]">
                VILLA RESIDENZIALE — SBALZO IN C.A., INNESTO OROGRAFICO E SPA IPOGEA
              </span>
              <span class="text-[#8A8D76] text-[10px] uppercase tracking-wider">
                ANNO 2017 • ITALIA
              </span>
            </div>
          </div>
        </div>
      </article>

    </div>
  </div>
</BaseLayout>
